<?xml version="1.0"?> 
<sdf version="1.5">
  <world name="default">
    <physics type="ode">
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.0</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.9</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.0</contact_surface_layer>
        </constraints>
      </ode>
      <!-- <real_time_update_rate>-1</real_time_update_rate> -->
      <!-- <max_step_size>0.0020</max_step_size> -->
      <!--
        UCI Fork Edit: `real_time_update_rate` was previously -1 (uncapped), which is incompatible
        with PX4's lockstep requirement in `libgazebo_mavlink_interface.so`  (aborts at startup:
        "max_step_size of X s does not match real_time_update_rate of Y, aborting.").

        Under lockstep, `real_time_update_rate * max_step_size` must equal the target real-time
        factor (1.0 here). Re-enabled the max_step_size value that was previously commented out
        in the upstream repository of `uav-cyber-sim` (0.0020) and solved for the paired rate:
        1.0 / 0.0020 = 500.

        References:
          - Gazebo Classic physics parameters tutorial (states the
            `max_step_size x real_time_update_rate = real_time_factor` relationship):
            https://classic.gazebosim.org/tutorials?tut=physics_params
          
          - PX4 lockstep docs: https://docs.px4.io/main/en/sim_gazebo_classic/

        Diagnosis and fix recommendation via Claude (Anthropic).
      -->
      <real_time_update_rate>500</real_time_update_rate>
      <max_step_size>0.0020</max_step_size>
    </physics>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5000 5000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="runway">
          <pose>000 0 0.005 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1829 45</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Runway</name>
            </script>
          </material>
        </visual>

        <visual name="grass">
          <pose>0 0 -0.1 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5000 5000</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grass</name>
            </script>
          </material>
        </visual>

      </link>
    </model>

    <include>
      <uri>model://sun</uri>
    </include>
  </world>
</sdf>