{
  "typeCheckingMode": "strict",
  "reportMissingTypeStubs": false,
  "ignoreMissingImports": [
    "pymavlink"
  ],
  /* UCI TODO: Remove these PyLance ignore error exceptions after
               ArduPilot has been replaced with PX4. */
  "reportUnusedImport": "none",
  "reportUnusedVariable": "none",
  /**
     UCI NOTE: These error exceptions have been added to prevent false positive
               type errors from being shown when using PyMavLink.
  **/
  "reportUnknownMemberType": "none",
  "reportAttributeAccessIssue": "none",
  "reportUnknownArgumentType": "none",
  "reportUnknownVariableType": "none",
  "reportMissingParameterType": "none",
  "reportUnknownParameterType": "none"
}